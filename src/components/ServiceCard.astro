---
import type { Service } from '../config/schema';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<a 
  href={service.url} 
  target="_blank" 
  rel="noopener noreferrer"
  class="group relative flex items-center gap-4 rounded-2xl bg-gray-900 border border-gray-800 p-5 transition-all duration-300 hover:scale-[1.02] hover:bg-gray-800 hover:border-gray-700 hover:shadow-xl hover:shadow-indigo-500/10 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-gray-950"
>
  {service.icon && (
    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gray-800 text-2xl group-hover:bg-gray-700 transition-colors">
      {service.icon}
    </div>
  )}
  
  <div class="flex flex-col">
    <h3 class="font-semibold text-gray-100 group-hover:text-indigo-400 transition-colors">
      {service.name}
    </h3>
    {service.description && (
      <p class="text-sm text-gray-400 line-clamp-2">
        {service.description}
      </p>
    )}
  </div>
</a>
