---
import '../styles/global.css'
import rawConfig from '../../services.json';
import { configSchema, type Service } from '../config/schema';

// Allow self-signed certificates for homelab subdomains during build
process.env.NODE_TLS_REJECT_UNAUTHORIZED = '0';

// 1. Validate configuration at build time
const parsedServices = configSchema.parse(rawConfig);

// 2. Fetch favicons at build time for public subdomains (*.cribothy.us)
const servicesWithIcons = await Promise.all(
	parsedServices.map(async (service) => {
		let iconDataUri: string | null = null;

		try {
			const controller = new AbortController();
			const timeoutId = setTimeout(() => controller.abort(), 4000);

			// Fetch the homepage HTML to find the true favicon path
			const htmlRes = await fetch(service.url, { signal: controller.signal }).catch(() => null);
			clearTimeout(timeoutId);

			let iconUrl = new URL('/favicon.ico', service.url).href;
			
			if (htmlRes && htmlRes.ok) {
				const html = await htmlRes.text();
				const match = html.match(/<link[^>]*rel=["'](?:shortcut )?icon["'][^>]*href=["']([^"']+)["'][^>]*>/i);
				if (match && match[1]) {
					iconUrl = new URL(match[1], service.url).href;
				}
			}

			// Download the image and convert to Base64
			const imgRes = await fetch(iconUrl);
			if (imgRes.ok) {
				const arrayBuffer = await imgRes.arrayBuffer();
				const buffer = Buffer.from(arrayBuffer);
				const contentType = imgRes.headers.get('content-type') || 'image/x-icon';
				iconDataUri = `data:${contentType};base64,${buffer.toString('base64')}`;
			}
		} catch (error) {
			console.warn(`[Warn] Could not fetch favicon for ${service.name} at ${service.url}`);
		}

		return { ...service, iconDataUri };
	})
);

// 3. Group services by category
const groupedServices = servicesWithIcons.reduce((acc, service) => {
	const cat = service.category;
	if (!acc[cat]) acc[cat] = [];
	acc[cat].push(service);
	return acc;
}, {} as Record<string, (Service & { iconDataUri: string | null })[]>);

const categories = Object.keys(groupedServices).sort();
---

<!doctype html>
<html lang="en" class="bg-zinc-950 text-zinc-100 antialiased">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Cribothy Links</title>
	</head>
	<body class="min-h-screen flex flex-col items-center p-6 md:p-12 font-sans selection:bg-emerald-500/30">
		<main class="w-full max-w-3xl flex-1 flex flex-col gap-12">
			
			<header class="text-center space-y-4 mt-8">
				<h1 class="text-4xl md:text-5xl font-bold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-400">
				    Cribothy	
				</h1>
				<p class="text-zinc-400 text-lg max-w-xl mx-auto">
                    Rom and Clark's k8s services
				</p>
			</header>

			<div class="space-y-12 pb-12">
				{categories.map((category) => (
					<section class="space-y-4">
						<h2 class="text-sm font-bold uppercase tracking-wider text-zinc-500 pl-1 border-l-2 border-emerald-500/50">
							{category}
						</h2>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							{groupedServices[category].map((service) => (
								<a 
									href={service.url} 
									target="_blank" 
									rel="noopener noreferrer"
									class="group relative flex items-center gap-4 rounded-2xl bg-zinc-900/50 border border-zinc-800/50 p-5 transition-all duration-300 hover:scale-[1.02] hover:bg-zinc-800/80 hover:border-emerald-500/30 hover:shadow-xl hover:shadow-emerald-500/10 focus:outline-none focus:ring-2 focus:ring-emerald-500"
								>
									{service.iconDataUri ? (
										<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-zinc-900 overflow-hidden">
											<img src={service.iconDataUri} alt={`${service.name} icon`} class="h-7 w-7 object-contain" />
										</div>
									) : (
										<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-zinc-800 text-xl font-bold text-zinc-400 group-hover:bg-zinc-700 transition-colors uppercase">
											{service.name.charAt(0)}
										</div>
									)}
									
									<div class="flex flex-col">
										<h3 class="font-semibold text-zinc-100 group-hover:text-emerald-400 transition-colors">
											{service.name}
										</h3>
										{service.description && (
											<p class="text-sm text-zinc-400 mt-0.5 line-clamp-2">
												{service.description}
											</p>
										)}
									</div>
								</a>
							))}
						</div>
					</section>
				))}
			</div>

		</main>
	</body>
</html>
