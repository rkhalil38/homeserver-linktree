---
import "../styles/global.css"

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-gray-950 text-gray-100 antialiased">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen flex flex-col items-center p-6 md:p-12 font-sans selection:bg-indigo-500/30">
		<main class="w-full max-w-3xl flex-1 flex flex-col gap-12">
			<slot />
		</main>
	</body>
</html>
